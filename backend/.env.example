# Backend
#
# 使い方: cp .env.example .env  →  値を編集  →  Backend を再起動
#
# LLM プロバイダー切替（LLM_PROVIDER）:
#   stub   … LLM なし（ヒューリスティックのみ。既定・デモ向け）
#   ollama … ローカル Ollama（要: ollama pull 済み、OLLAMA_* を合わせる）
#   openai … OpenAI API（要: OPENAI_API_KEY を設定）
#
# 切替後: http://127.0.0.1:8000/health の llm.wired が true なら接続 OK
#
LLM_PROVIDER=stub
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# LLM sample size / timeouts (group stance mode)
LLM_MAX_AGENTS_PER_TURN=4
LLM_TIMEOUT_SEC=8
LLM_CONCURRENCY=1
LLM_GROUP_SAMPLE_PER_REGION=12
# UI向け要約・理由の言語（ja|en）
LLM_NARRATIVE_LANG=ja
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
